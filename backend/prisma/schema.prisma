generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  name       String
  employeeId String   @unique
  email      String   @unique
  password   String
  role       String   @default("viewer") // 'admin', 'superadmin', 'viewer', 'department'
  department String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Project {
  id                     String            @id @default(uuid())
  title                  String
  projectId              String            @unique
  category               String // 'Road', 'Water Supply', 'Drainage', 'Park/Garden', 'Building', 'Electricity', 'Other'
  description            String
  ward                   String
  fromLocation           String
  toLocation             String?
  googleMapsLink         String?
  latitude               Float?
  longitude              Float?
  estimatedCost          Float
  amountSpent            Float             @default(0)
  contractor             String?
  status                 String            @default("Planned") // 'Planned', 'Tender Issued', 'In Progress', 'On Hold', 'Completed', 'Cancelled'
  completionPercent      Float             @default(0)
  startDate              DateTime
  expectedCompletionDate DateTime
  actualCompletionDate   DateTime?
  isPublic               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  // Relations
  officials              ProjectOfficial[]
  documents              ProjectDocument[]
  updates                ProjectUpdate[]
  images                 String[]
}

model ProjectOfficial {
  id            String  @id @default(uuid())
  name          String
  designation   String
  department    String?
  contactNumber String?
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectDocument {
  id        String  @id @default(uuid())
  name      String?
  url       String?
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  note      String?
  updatedBy String?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model OfficialMaster {
  id            String   @id @default(uuid())
  name          String
  designation   String
  department    String?
  contactNumber String?
  createdAt     DateTime @default(now())
}

model ContractorMaster {
  id            String   @id @default(uuid())
  firmName      String
  contactPerson String?
  contactNumber String?
  createdAt     DateTime @default(now())
}
